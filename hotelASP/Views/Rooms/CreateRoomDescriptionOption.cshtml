@model hotelASP.Models.RoomDescriptionViewModel

@{
    ViewData["Title"] = "Opcje pokojów";
}

<div class="create-room-container">
    <div class="headerMain">
        <div class="header-text">
            <h3>Nowa opcja wyposażenia</h3>
            <p class="text-muted mb-0">Dodaj nowy element (np. "Klimatyzacja", "WiFi") do listy udogodnień.</p>
        </div>
        <div class="headerMain-actions">
            <a asp-controller="Rooms" asp-action="CreateRoom" class="btn btn-secondary-custom">
                <i class="bi bi-arrow-left"></i> Wróć do listy
            </a>
        </div>
    </div>

    <div class="cardMain">
        <form asp-action="CreateRoomDescriptionOption">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-groupMain">
                <label asp-for="NewOption.Name" class="control-label">Nazwa opcji:</label>
                <input asp-for="NewOption.Name" class="form-control" />
                <span asp-validation-for="NewOption.Name" class="text-danger"></span>
            </div>
            <div class="form-actions mt-4">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
            </div>
        </form>
    </div>

    <h3>Obecne opcje:</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Nazwa opcji</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ExistingOptions)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>
                        <form asp-action="DeleteRoomDescriptionOption" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.ID" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Czy na pewno chcesz usunąć tę opcję?');">Usuń</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
