@model hotelASP.Models.Reports.ReportFilterViewModel

@{
    ViewData["Title"] = "Raporty Hotelowe";
}

<div class="mainPage">
    <div class="headerMain">
        <h3>📊 System Raportów</h3>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Generuj Raport</h5>
                </div>
                <div class="card-body">
                    <form asp-action="GenerateReport" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DateFrom" class="form-label">Data od</label>
                                <input asp-for="DateFrom" type="date" class="form-control" />
                                <span asp-validation-for="DateFrom" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateTo" class="form-label">Data do</label>
                                <input asp-for="DateTo" type="date" class="form-control" />
                                <span asp-validation-for="DateTo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ReportType" class="form-label">Wybierz typ raportu</label>
                            <div class="report-type-cards">
                                <div class="report-card">
                                    <input type="radio" asp-for="ReportType" value="Income" id="reportIncome" checked />
                                    <label for="reportIncome">
                                        <div class="report-icon">💰</div>
                                        <h6>Raport Przychodów</h6>
                                        <p>Analiza przychodów z rezerwacji i zamówień</p>
                                    </label>
                                </div>

                                <div class="report-card">
                                    <input type="radio" asp-for="ReportType" value="Customers" id="reportCustomers" />
                                    <label for="reportCustomers">
                                        <div class="report-icon">👥</div>
                                        <h6>Raport Klientów</h6>
                                        <p>Statystyki odwiedzających i ich aktywności</p>
                                    </label>
                                </div>

                                <div class="report-card">
                                    <input type="radio" asp-for="ReportType" value="Orders" id="reportOrders" />
                                    <label for="reportOrders">
                                        <div class="report-icon">🍽️</div>
                                        <h6>Raport Zamówień</h6>
                                        <p>Analiza zamówień i popularnych pozycji</p>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">
                            📈 Generuj Raport
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">💡 Informacje</h6>
                </div>
                <div class="card-body">
                    <h6>Dostępne raporty:</h6>
                    <ul>
                        <li><strong>Przychody</strong> - przychody z rezerwacji i zamówień, podział według miesięcy i typów pokoi</li>
                        <li><strong>Klienci</strong> - liczba nowych i powracających klientów, top klienci</li>
                        <li><strong>Zamówienia</strong> - statystyki zamówień, popularne pozycje menu</li>
                    </ul>
                    <hr />
                    <p class="mb-0"><small class="text-muted">Wybierz zakres dat i typ raportu, aby wygenerować szczegółową analizę.</small></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .report-type-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 10px;
    }

    .report-card {
        position: relative;
    }

    .report-card input[type="radio"] {
        position: absolute;
        opacity: 0;
    }

    .report-card label {
        display: block;
        padding: 20px;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
        background: white;
    }

    .report-card input[type="radio"]:checked + label {
        border-color: #28a745;
        background: #f0f9f3;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.2);
    }

    .report-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }

    .report-card h6 {
        margin-bottom: 8px;
        color: #2f3b5e;
    }

    .report-card p {
        font-size: 0.85rem;
        color: #6c757d;
        margin: 0;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}