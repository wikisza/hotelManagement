@model hotelASP.Models.Reports.ReportFilterViewModel

@{
    ViewData["Title"] = "System Raportów";
    Layout = "~/Views/Shared/_ReportsLayout.cshtml";
}

<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-dark mb-2">System Raportów</h1>
        <p class="lead text-muted">Generuj szczegółowe analizy działalności hotelu</p>
    </div>

    <!-- Main Form -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="GenerateReport" method="post">
                        @Html.AntiForgeryToken()
                        
                        <!-- Date Range Selection -->
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="DateFrom" class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-2"></i>Data od
                                </label>
                                <input asp-for="DateFrom" type="date" class="form-control form-control-lg" />
                                <span asp-validation-for="DateFrom" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateTo" class="form-label fw-bold">
                                    <i class="bi bi-calendar-check me-2"></i>Data do
                                </label>
                                <input asp-for="DateTo" type="date" class="form-control form-control-lg" />
                                <span asp-validation-for="DateTo" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Report Type Selection -->
                        <div class="mb-5">
                            <h5 class="fw-bold mb-4 text-center">Wybierz typ raportu</h5>
                            <div class="row g-4">
                                <!-- Income Report -->
                                <div class="col-lg-4">
                                    <input type="radio" asp-for="ReportType" value="Income" id="reportIncome" 
                                           class="btn-check" checked />
                                    <label for="reportIncome" class="report-card-selectable">
                                        <div class="report-icon-wrapper bg-success bg-opacity-10">
                                            <i class="bi bi-graph-up-arrow text-success"></i>
                                        </div>
                                        <h5 class="fw-bold mt-3 mb-2">Raport Przychodów</h5>
                                        <p class="text-muted small mb-0">
                                            Szczegółowa analiza przychodów z rezerwacji, zamówień i podziałem na kategorie
                                        </p>
                                    </label>
                                </div>

                                <!-- Customer Report -->
                                <div class="col-lg-4">
                                    <input type="radio" asp-for="ReportType" value="Customers" id="reportCustomers" 
                                           class="btn-check" />
                                    <label for="reportCustomers" class="report-card-selectable">
                                        <div class="report-icon-wrapper bg-primary bg-opacity-10">
                                            <i class="bi bi-people text-primary"></i>
                                        </div>
                                        <h5 class="fw-bold mt-3 mb-2">Raport Klientów</h5>
                                        <p class="text-muted small mb-0">
                                            Statystyki klientów, ranking najlepszych gości i analiza lojalności
                                        </p>
                                    </label>
                                </div>

                                <!-- Order Report -->
                                <div class="col-lg-4">
                                    <input type="radio" asp-for="ReportType" value="Orders" id="reportOrders" 
                                           class="btn-check" />
                                    <label for="reportOrders" class="report-card-selectable">
                                        <div class="report-icon-wrapper bg-warning bg-opacity-10">
                                            <i class="bi bi-cart-check text-warning"></i>
                                        </div>
                                        <h5 class="fw-bold mt-3 mb-2">Raport Zamówień</h5>
                                        <p class="text-muted small mb-0">
                                            Analiza zamówień, popularne pozycje menu i dzienny rozkład sprzedaży
                                        </p>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                                <i class="bi bi-file-earmark-bar-graph me-2"></i>
                                Generuj Raport
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info Card -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-info-circle me-2"></i>Informacje o raportach
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="d-block">Eksport PDF i Excel</strong>
                                    <small class="text-muted">Pobierz raporty w wygodnym formacie</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="d-block">Wydruk bezpośredni</strong>
                                    <small class="text-muted">Drukuj raporty jednym kliknięciem</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                <div>
                                    <strong class="d-block">Dane w czasie rzeczywistym</strong>
                                    <small class="text-muted">Zawsze aktualne informacje</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .report-card-selectable {
        display: block;
        padding: 2rem;
        border: 3px solid #e9ecef;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
        height: 100%;
        text-align: center;
    }

    .report-card-selectable:hover {
        border-color: #0d6efd;
        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.15);
        transform: translateY(-4px);
    }

    .btn-check:checked + .report-card-selectable {
        border-color: #0d6efd;
        background: linear-gradient(135deg, #ffffff 0%, #e7f1ff 100%);
        box-shadow: 0 8px 24px rgba(13, 110, 253, 0.25);
        transform: translateY(-2px);
    }

    .report-icon-wrapper {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        font-size: 2.5rem;
        margin: 0 auto;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}