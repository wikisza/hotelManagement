@model hotelASP.Models.Reports.IncomeReportViewModel

@{
    ViewData["Title"] = "Raport Przychodów";
    Layout = "~/Views/Shared/_ReportsLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-0">Raport Finansowy</h2>
            <small class="text-muted">
                Okres: <span class="fw-semibold">@Model.DateFrom.ToString("dd.MM.yyyy")</span> - <span class="fw-semibold">@Model.DateTo.ToString("dd.MM.yyyy")</span>
            </small>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="ExportIncomeReportToExcel" 
               asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" 
               asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" 
               class="btn btn-outline-success">
                <i class="bi bi-file-excel"></i> Excel
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Wróć
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i class="bi bi-printer"></i> Drukuj
            </button>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Całkowity Przychód</p>
                            <h2 class="fw-bold text-dark mb-0">@Model.TotalIncome.ToString("C0")</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-3">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Z Rezerwacji</p>
                            <h3 class="fw-bold text-dark mb-0">@Model.ReservationIncome.ToString("C0")</h3>
                            <small class="text-primary">@Model.TotalReservations rezerwacji</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 fs-3">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Restauracja/Bar</p>
                            <h3 class="fw-bold text-dark mb-0">@Model.OrdersIncome.ToString("C0")</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 fs-3">
                            <i class="bi bi-cup-hot"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">Zestawienie Miesięczne</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-secondary small text-uppercase">Miesiąc</th>
                                <th class="text-end text-secondary small text-uppercase">Rezerwacje</th>
                                <th class="text-end text-secondary small text-uppercase">Zamówienia</th>
                                <th class="text-end pe-4 text-secondary small text-uppercase">Razem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MonthlyBreakdown.Any())
                            {
                                @foreach (var m in Model.MonthlyBreakdown)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@m.Month</td>
                                        <td class="text-end text-muted">@m.ReservationIncome.ToString("C")</td>
                                        <td class="text-end text-muted">@m.OrdersIncome.ToString("C")</td>
                                        <td class="text-end pe-4 fw-bold text-success">@m.TotalIncome.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">Brak danych w wybranym okresie.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light border-top">
                            <tr>
                                <td class="ps-4 fw-bold">SUMA</td>
                                <td class="text-end fw-bold">@Model.ReservationIncome.ToString("C")</td>
                                <td class="text-end fw-bold">@Model.OrdersIncome.ToString("C")</td>
                                <td class="text-end pe-4 fw-bold text-success">@Model.TotalIncome.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">Przychód wg Typu Pokoju</h6>
                </div>
                <div class="card-body">
                    @if (Model.RoomTypeBreakdown.Any())
                    {
                        @foreach (var room in Model.RoomTypeBreakdown)
                        {
                            var percentage = Model.ReservationIncome > 0 ? room.Income / Model.ReservationIncome * 100 : 0;
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-semibold text-dark">@room.RoomType</span>
                                    <span class="text-success fw-bold">@room.Income.ToString("C0")</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @percentage%"></div>
                                </div>
                                <div class="text-end mt-1">
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @room.ReservationsCount rezerwacji (@percentage.ToString("F0")%)
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Brak danych.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>