@model hotelASP.Models.Reports.OrderReportViewModel

@{
    ViewData["Title"] = "Raport Zamówień";
    Layout = "~/Views/Shared/_ReportsLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-0">Raport Zamówień</h2>
            <small class="text-muted">
                Okres: <span class="fw-semibold">@Model.DateFrom.ToString("dd.MM.yyyy")</span> - <span class="fw-semibold">@Model.DateTo.ToString("dd.MM.yyyy")</span>
            </small>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="ExportOrderReportToExcel" 
               asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")" 
               asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")" 
               class="btn btn-outline-success">
                <i class="bi bi-file-excel"></i> Excel
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Wróć
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i class="bi bi-printer"></i> Drukuj
            </button>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Łączna liczba</p>
                            <h2 class="fw-bold text-dark mb-0">@Model.TotalOrders</h2>
                            <small class="text-muted">zamówień</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 fs-3">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Wartość zamówień</p>
                            <h2 class="fw-bold text-dark mb-0">@Model.TotalOrdersValue.ToString("C0")</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 fs-3">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-info">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Średnia wartość</p>
                            <h2 class="fw-bold text-dark mb-0">@Model.AverageOrderValue.ToString("C0")</h2>
                            <small class="text-muted">na zamówienie</small>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 fs-3">
                            <i class="bi bi-graph-up"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-star-fill text-warning me-2"></i>Najpopularniejsze pozycje menu
                    </h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-secondary small text-uppercase">Pozycja</th>
                                <th class="text-secondary small text-uppercase">Nazwa</th>
                                <th class="text-center text-secondary small text-uppercase">Zamówienia</th>
                                <th class="text-end text-secondary small text-uppercase">Przychód</th>
                                <th class="text-end pe-4 text-secondary small text-uppercase">Popularność</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PopularItems.Any())
                            {
                                int rank = 1;
                                var maxOrders = Model.PopularItems.Max(p => p.OrderCount);
                                foreach (var item in Model.PopularItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @if (rank <= 3)
                                            {
                                                <span class="badge bg-warning text-dark">@rank</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">@rank</span>
                                            }
                                        </td>
                                        <td><strong>@item.ItemName</strong></td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@item.OrderCount szt.</span>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-success">@item.Revenue.ToString("C")</strong>
                                        </td>
                                        <td class="text-end pe-4" style="width: 200px;">
                                            <div class="d-flex align-items-center justify-content-end">
                                                <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                    <div class="progress-bar bg-success" 
                                                         style="width: @((item.OrderCount / (double)maxOrders * 100))%"></div>
                                                </div>
                                                <small class="text-muted">@((item.OrderCount / (double)maxOrders * 100).ToString("F0"))%</small>
                                            </div>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">Brak zamówień w wybranym okresie.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-calendar-day me-2"></i>Dzienny rozkład zamówień
                    </h6>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (Model.DailyBreakdown.Any())
                    {
                        var maxDailyValue = Model.DailyBreakdown.Max(d => d.TotalValue);
                        foreach (var day in Model.DailyBreakdown.OrderBy(d => d.Date))
                        {
                            var percentage = maxDailyValue > 0 ? day.TotalValue / maxDailyValue * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-semibold">@day.Date.ToString("dd.MM.yyyy")</span>
                                    <span class="text-muted small">@day.OrdersCount zamówień</span>
                                </div>
                                <div class="progress" style="height: 32px;">
                                    <div class="progress-bar bg-gradient" 
                                         style="width: @percentage%; background: linear-gradient(90deg, #28a745, #20c997);"
                                         role="progressbar">
                                        <span class="fw-bold">@day.TotalValue.ToString("C")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Brak danych.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-list-check me-2"></i>Zamówienia według statusu
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.OrdersByStatus.Any())
                    {
                        var totalOrders = Model.OrdersByStatus.Sum(o => o.Count);
                        foreach (var status in Model.OrdersByStatus)
                        {
                            var percentage = totalOrders > 0 ? status.Count / (double)totalOrders * 100 : 0;
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-dark">@status.Status</strong>
                                    <span class="badge bg-primary">@status.Count</span>
                                </div>
                                <div class="mb-2">
                                    <small class="text-success">@status.TotalValue.ToString("C")</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" 
                                         style="width: @percentage%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Brak danych.</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-bar-chart me-2"></i>Statystyki
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Średnia dzienna:</span>
                        <strong class="text-primary">
                            @(Model.DailyBreakdown.Any() ? (Model.TotalOrders / Model.DailyBreakdown.Count).ToString("F1") : "0") zam.
                        </strong>
                    </div>
                    @if (Model.DailyBreakdown.Any())
                    {
                        var bestDay = Model.DailyBreakdown.OrderByDescending(d => d.TotalValue).First();
                        <div class="py-2">
                            <div class="text-muted mb-1">Najlepszy dzień:</div>
                            <strong class="text-success d-block">@bestDay.Date.ToString("dd.MM.yyyy")</strong>
                            <small class="text-muted">@bestDay.TotalValue.ToString("C")</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>